# Copy this to .env (local) and set secure values in production.

# Editor login credentials
EDITOR_USER=pratham@dev.com
EDITOR_PASS=Prathu@020406

# Required for signed admin session tokens.
# Use at least 32 random characters in production.
SESSION_SECRET=change-this-to-a-long-random-secret

# Optional session duration in seconds (default: 28800 = 8 hours)
SESSION_TTL_SECONDS=28800

# Production content persistence via GitHub contents API.
# Set these in Vercel so admin edits are written back to the repo and redeploy cleanly.
CONTENT_REPO_OWNER=your-github-username-or-org
CONTENT_REPO_NAME=your-repo-name
CONTENT_REPO_BRANCH=main
CONTENT_REPO_PATH=src/data/site-content.json
CONTENT_REPO_UPLOAD_PATH=public/uploads
GITHUB_TOKEN=your-github-personal-access-token
