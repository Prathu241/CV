---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { getContent } from '../lib/content';
import { isAuthenticated } from '../lib/auth';
import EditModal from '../components/EditModal.astro';

const data = getContent();
const { skills, experience, projects, education, socialLinks, profile } = data;
const isLoggedIn = isAuthenticated(Astro.cookies);
---

<Layout title="Pratham Sarawad | Portfolio">
  <!-- Navigation -->
  <nav class="fixed w-full z-40 top-0 start-0 border-b border-white/10 bg-[#07101d]/72 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between p-4">
      <a href="#" class="flex items-center space-x-3 rtl:space-x-reverse group">
        <span class="self-center text-xl font-semibold whitespace-nowrap text-white transition-colors duration-300">
          Pratham Sarawad
        </span>
      </a>
      <button data-collapse-toggle="navbar-default" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-slate-300 rounded-lg md:hidden hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-primary/30" aria-controls="navbar-default" aria-expanded="false" id="menu-toggle">
          <span class="sr-only">Open main menu</span>
          <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
          </svg>
      </button>

      {isLoggedIn && (
        <form method="POST" action="/api/auth/logout" class="hidden md:block">
          <button type="submit" class="px-3 py-2 text-xs rounded-lg border border-white/15 text-white/80 hover:text-white hover:border-white/30 transition-colors">
            Exit edit mode
          </button>
        </form>
      )}

      <div class="hidden w-full md:block md:w-auto" id="navbar-default">
        <ul class="font-medium flex flex-col p-4 md:p-0 mt-4 md:flex-row md:space-x-5 rtl:space-x-reverse md:mt-0 bg-surface md:bg-transparent border border-white/10 md:border-0 rounded-2xl md:rounded-none shadow-xl md:shadow-none">
          {['About', 'Experience', 'Projects', 'Skills'].map((item) => (
            <li>
              <a href={item === 'Projects' ? '/projects' : item === 'Skills' ? '/skills' : `#${item.toLowerCase()}`} class="magnetic relative block py-2 px-3 text-slate-200 hover:text-primary transition-colors duration-300 group hover:bg-white/5 md:hover:bg-transparent rounded-lg md:rounded-none text-[15px]">
                {item}
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full hidden md:block"></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {isLoggedIn && (
      <form method="POST" action="/api/auth/logout" class="px-4 pb-3 md:hidden">
        <button type="submit" class="w-full px-3 py-2 text-xs rounded-lg border border-white/15 text-white/80 hover:text-white hover:border-white/30 transition-colors">
          Exit edit mode
        </button>
      </form>
    )}

  </nav>

  <script>
      const menuToggle = document.getElementById('menu-toggle');
      const navbar = document.getElementById('navbar-default');
      
      if (menuToggle && navbar) {
          menuToggle.addEventListener('click', () => {
              navbar.classList.toggle('hidden');
          });
      }

      const params = new URLSearchParams(window.location.search);
      if (params.get('logged_out') === '1') {
        const toast = document.createElement('div');
        toast.setAttribute('role', 'status');
        toast.className = 'fixed bottom-5 right-5 z-[70] rounded-lg border border-primary/30 bg-[#0b1320]/95 px-4 py-3 text-sm text-white shadow-lg backdrop-blur transition-all duration-300 opacity-100 translate-y-0';
        toast.textContent = 'Session ended. Edit mode is off.';
        document.body.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-2');
        }, 2200);

        setTimeout(() => {
          toast.remove();
        }, 2800);

        params.delete('logged_out');
        const query = params.toString();
        const cleanUrl = `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`;
        window.history.replaceState({}, '', cleanUrl);
      }
  </script>

  <main>
    <!-- Hero / Header -->
    <section class="min-h-screen flex items-center justify-center relative section-padding pt-28 sm:pt-32">
        {isLoggedIn && (
          <button onclick="window.openVisualEditor('profile')" class="absolute top-20 left-4 z-50 bg-white/5 hover:bg-white/10 text-white border border-white/10 px-3 py-2 rounded-lg backdrop-blur-md transition-all duration-300 text-xs">
            Edit profile
            </button>
        )}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-center w-full max-w-6xl mx-auto">
            <div class="text-left order-2 md:order-1 animate-on-scroll max-w-2xl mx-auto md:mx-0 parallax-item" data-parallax-speed="-0.03">
                <div class="inline-flex items-center px-3.5 py-1.5 border border-white/15 bg-white/5 text-slate-200 text-[11px] sm:text-xs tracking-[0.14em] mb-6 uppercase rounded-md">
                  Open for opportunities
                </div>
                
                  <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold mb-5 sm:mb-6 tracking-tight leading-[0.95] text-white max-w-[11ch]">
                    {profile.name.split(' ')[0]}<br/>
                    <span class="headline-accent" data-text={profile.name.split(' ')[1] || ""}>
                        {profile.name.split(' ')[1] || ""}
                    </span>
                </h1>
                
                  <p class="text-base sm:text-lg md:text-xl text-slate-200 mb-7 sm:mb-8 leading-relaxed max-w-xl">
                    {profile.role}<br/>
                    <span class="text-slate-300 text-xs sm:text-sm mt-2 block">{profile.bio}</span>
                </p>
                
                <div class="flex flex-wrap gap-3 sm:gap-3.5 mb-8 sm:mb-10">
                    {socialLinks.slice(0, 3).map(link => (
                     <a href={link.url} target="_blank" rel="noopener noreferrer" class="magnetic p-3 sm:p-3.5 border border-white/12 bg-white/5 hover:bg-white/10 hover:border-primary/30 transition-all duration-300 group rounded-lg" aria-label={link.name}>
                            <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d={link.icon}/></svg>
                        </a>
                    ))}
                    <a href="/MY_RESUME-1.pdf" download class="magnetic cta-primary inline-flex items-center px-6 sm:px-7 py-3.5 bg-primary text-black font-semibold hover:bg-secondary transition-all duration-300 tracking-wide text-sm border border-primary rounded-lg shadow-[0_10px_24px_-18px_rgba(34,211,238,0.8)]">
                        Download resume
                    </a>
                </div>
            </div>

            <div class="order-1 md:order-2 flex justify-center animate-on-scroll relative parallax-item" data-parallax-speed="0.02" style="animation-delay: 0.2s">
              <div class="relative w-56 h-56 sm:w-72 sm:h-72 md:w-[24rem] md:h-[24rem]">
                    <div class="absolute inset-0 border border-white/15 translate-x-3 translate-y-3 sm:translate-x-4 sm:translate-y-4 rounded-2xl"></div>
                    
                    <div class="relative w-full h-full bg-surface overflow-hidden border border-white/10 group transition-all duration-500 rounded-2xl">
                         <img 
                            src={profile.image} 
                            alt={profile.name} 
                            class="w-full h-full object-contain bg-surface" 
                             onerror="this.src='https://ui-avatars.com/api/?name=Pratham+Sarawad&background=0a0e14&color=2dd4bf&size=512'" 
                         />
                    </div>
                 </div>
            </div>
        </div>
    </section>



    <!-- About Me -->
           <Section id="about" title="About Me">
                <div class="cyber-card p-6 sm:p-8 md:p-10 relative group">
        {isLoggedIn && (
            <button onclick="window.openVisualEditor('profile')" class="absolute top-4 right-4 z-10 bg-white/5 hover:bg-white/10 text-white border border-white/10 px-3 py-1 rounded-lg backdrop-blur-md transition-all duration-300 text-xs">
              Edit
            </button>
        )}
        <div class="flex flex-col md:flex-row gap-6 sm:gap-8 items-start">
            <div class="flex-1">
          <p class="text-base sm:text-lg md:text-xl leading-relaxed text-slate-200 font-light mb-6 whitespace-pre-line">{profile.about}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4 text-sm text-slate-300">
                    <div class="flex items-center gap-2">
                        <span class="text-primary">></span> FOCUS: {profile.focus}
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-primary">></span> ROLE: {profile.role_detail}
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-primary">></span> STATUS: {profile.status}
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-primary">></span> LOC: {profile.location}
                    </div>
                </div>
            </div>
        </div>
      </div>
    </Section>

    <!-- Experience -->
    <Section id="experience" title="Experience">
      <div class="relative border-l border-white/10 ml-1 sm:ml-2 space-y-8">
        {isLoggedIn && (
            <div class="absolute -top-12 right-0 z-10">
              <button onclick="window.openVisualEditor('experience')" class="bg-white/5 hover:bg-white/10 text-white border border-white/10 px-3 py-1 rounded-lg backdrop-blur-md transition-all duration-300 text-xs">
                Edit experience
                </button>
            </div>
        )}
        {experience.map((exp, index) => (
          <div class="relative pl-6 sm:pl-8 group animate-on-scroll stagger-item" style={`--stagger:${index};`}>
             <!-- Tech marker -->
            <div class="absolute left-0 top-0 -translate-x-1/2 flex flex-col items-center">
                <div class="w-3 h-3 bg-background border border-primary rotate-45 group-hover:bg-primary transition-colors"></div>
            </div>
            
            <div class="cyber-card p-6 sm:p-8 group-hover:border-l-4 group-hover:border-l-primary transition-all">
               <div class="flex flex-col md:flex-row justify-between mb-6 border-b border-white/5 pb-4">
                  <div>
                    <h3 class="text-2xl font-semibold text-white hover:text-primary transition-colors">{exp.role}</h3>
                    <h4 class="text-md text-slate-300 mt-1">{exp.company}</h4>
                  </div>
                  <span class="mt-2 md:mt-0 text-xs text-primary bg-primary/12 px-3 py-2 h-fit border border-primary/20 rounded-full">
                    {exp.date}
                  </span>
               </div>
               
               <ul class="space-y-3">
                   {exp.details.map(detail => (
                       <li class="pl-4 border-l-2 border-white/10 text-slate-300 text-sm hover:border-primary hover:text-white transition-colors">
                           {detail}
                       </li>
                   ))}
               </ul>
            </div>
          </div>
        ))}
      </div>
    </Section>

    <!-- Projects -->
    <Section id="projects" title="Projects">
      <div class="relative grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
        {isLoggedIn && (
            <div class="absolute -top-12 right-0 z-10 w-full flex justify-end">
                <button onclick="window.openVisualEditor('projects')" class="bg-white/5 hover:bg-white/10 text-white border border-white/10 px-3 py-1 rounded-lg backdrop-blur-md transition-all duration-300 text-xs">
                  Edit projects
                </button>
            </div>
        )}
        {projects.slice(0, 2).map((project, index) => (
          <div class="cyber-card group h-full flex flex-col animate-on-scroll stagger-item" style={`--stagger:${index};`}>
            <div class="h-40 sm:h-48 bg-[#0a1422] relative overflow-hidden border-b border-white/5">
                 <div class="absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,rgba(255,255,255,0.02)_50%,transparent_75%,transparent_100%)] bg-[length:20px_20px]"></div>
            </div>
            
            <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-xl font-semibold text-white mb-3 group-hover:text-primary transition-colors">{project.title}</h3>
                <p class="text-slate-300 text-sm leading-relaxed mb-6 flex-grow font-light border-l border-primary/30 pl-4">
                  {project.desc}
                </p>
                
                <div class="flex flex-wrap gap-2 pt-4 border-t border-white/5">
                    {project.tech.map(t => (
                        <span class="text-[10px] uppercase tracking-widest text-slate-200 bg-primary/12 border border-primary/20 px-2 py-1 rounded-full">
                          {t}
                        </span>
                    ))}
                </div>

                <div class="mt-4 flex flex-wrap gap-2">
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="magnetic cta-primary inline-flex items-center gap-2 rounded-md border border-primary/30 bg-primary/12 px-3 py-1.5 text-xs text-slate-100 hover:bg-primary/20 transition-colors">
                    Visit website
                  </a>
                  <a href={project.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-white/15 bg-white/5 px-3 py-1.5 text-xs text-slate-100 hover:bg-white/10 hover:border-white/25 transition-colors">
                    View repository
                  </a>
                </div>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
            <a href="/projects" class="magnetic cta-primary inline-flex items-center px-6 py-3 border border-primary text-primary hover:bg-primary hover:text-black transition-all duration-300 tracking-widest text-sm group rounded-lg">
              View all projects
                <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
      </div>
    </Section>

    <!-- Skills -->
    <Section id="skills" title="Core Skills">
      <div class="cyber-card p-6 sm:p-8 relative">
        {isLoggedIn && (
            <button onclick="window.openVisualEditor('skills')" class="absolute top-4 right-4 z-10 bg-white/5 hover:bg-white/10 text-white border border-white/10 px-3 py-1 rounded-lg backdrop-blur-md transition-all duration-300 text-xs">
            Edit
            </button>
        )}
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-8 gap-5 sm:gap-8 justify-items-center">
            {skills.slice(0, 8).map((skill, index) => (
              <div class="flex flex-col items-center gap-3 group w-full animate-on-scroll stagger-item" style={`--stagger:${index};`}>
                <div class="w-14 h-14 sm:w-16 sm:h-16 bg-white/6 flex items-center justify-center p-3 border border-white/12 group-hover:border-primary/50 transition-all duration-300 relative rounded-2xl shadow-[0_0_0_1px_rgba(255,255,255,0.02)]">
                     <img src={skill.icon} alt={skill.name} class="w-full h-full object-contain filter grayscale group-hover:grayscale-0 transition-all opacity-70 group-hover:opacity-100" />
                </div>
                <span class="text-xs text-slate-200 group-hover:text-primary transition-colors uppercase tracking-wider text-center text-nowrap">{skill.name}</span>
              </div>
            ))}
          </div>
          
          <div class="text-center pt-8 border-t border-white/5">
                <a href="/skills" class="inline-block text-slate-200 hover:text-primary text-xs uppercase tracking-widest border-b border-transparent hover:border-primary transition-all pb-1">
                    Explore the full stack
                </a>
          </div>
      </div>
    </Section>

    <!-- Call to Action -->
    <section class="section-padding py-32 text-center">
        <div class="max-w-4xl mx-auto space-y-8 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-semibold text-white tracking-tight">Let's build something <span class="text-primary">useful</span> together.</h2>
          <p class="text-xl text-slate-300 max-w-2xl mx-auto">Open to freelance, contract, or collaboration opportunities.</p>
            
            <div class="flex flex-wrap justify-center gap-6 mt-8">
                <a href="mailto:prathamspr@gmail.com" class="magnetic cta-primary px-8 py-4 bg-primary text-black font-bold rounded-lg hover:bg-secondary transition-colors">
                    Get in Touch
                </a>
                  <a href="mailto:prathamspr@gmail.com?subject=Schedule%20a%20Call" class="px-8 py-4 glass-card border border-primary/20 rounded-lg hover:border-primary/40 hover:text-primary transition-colors">
                    Schedule a Call
                </a>
            </div>
        </div>
    </section>

    <section class="signal-marquee">
      <div class="signal-marquee-track text-[11px] sm:text-xs uppercase tracking-[0.24em] text-slate-300">
        <span>Build With Clarity</span>
        <span>Ship With Quality</span>
        <span>Scale With Confidence</span>
        <span>Secure By Design</span>
        <span>Performance Focused</span>
        <span>Build With Clarity</span>
        <span>Ship With Quality</span>
        <span>Scale With Confidence</span>
        <span>Secure By Design</span>
        <span>Performance Focused</span>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-primary/20 bg-[#07101d]/70 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 py-8">
      <div class="flex justify-center items-center">
        <p class="text-slate-300 text-sm">
            © 2026 Pratham Sarawad. Built with <span class="text-white">Astro</span> & <span class="text-white">Tailwind</span>.
        </p>
      </div>
    </div>
  </footer>
  
  {isLoggedIn && <EditModal initialData={data} />}

</Layout>
