---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { getContent } from '../lib/content';

const { skills } = getContent();
---

<Layout title="Skills | Pratham Sarawad">
  <main class="pt-6 sm:pt-8 pb-14 min-h-screen">
    <Section id="all-skills" title="Skills" class="!pt-4 sm:!pt-6 !pb-12 sm:!pb-14">
      <div class="mb-8">
        <a href="/" class="magnetic inline-flex items-center text-slate-200 text-sm hover:text-primary transition-colors">
            ← Back to home
        </a>
      </div>

      <div class="cyber-card p-8 md:p-12">
          <div class="grid grid-cols-2 small:grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-8 justify-items-center">
            {skills.map((skill, index) => (
              <div class="flex flex-col items-center gap-3 group w-full animate-on-scroll stagger-item" style={`--stagger:${index};`}>
                <div class="w-20 h-20 bg-white/6 flex items-center justify-center p-4 border border-white/12 group-hover:border-primary transition-all duration-300 relative rounded-2xl shadow-[0_0_0_1px_rgba(255,255,255,0.02)]">
                     <img src={skill.icon} alt={skill.name} class="w-full h-full object-contain filter grayscale group-hover:grayscale-0 transition-all opacity-70 group-hover:opacity-100" />
                </div>
                <span class="text-xs text-slate-200 group-hover:text-primary transition-colors text-center tracking-wide">{skill.name}</span>
              </div>
            ))}
          </div>
      </div>
      
            <div class="mt-12 p-6 border border-white/10 bg-white/5 backdrop-blur-md rounded-2xl">
             <h3 class="text-white mb-5 text-center text-xs tracking-[0.35em] uppercase">Capabilities</h3>
             <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-slate-300 font-light">
            <div class="text-center md:text-left">
                <strong class="text-white block mb-1">Frontend architecture</strong>
                <p>Building responsive, high-performance interfaces with modern frameworks like React and Astro, focusing on component reusability and state management.</p>
            </div>
            <div class="text-center md:text-left">
                <strong class="text-white block mb-1">Backend systems</strong>
                <p>Designing scalable APIs and server-side logic using Node.js and Python (Flask/Django), ensuring secure data handling and efficient processing.</p>
            </div>
            <div class="text-center md:text-left">
                <strong class="text-white block mb-1">AI integration</strong>
                <p>Implementing machine learning models and NLP capabilities into web applications to create intelligent, adaptive user experiences.</p>
            </div>
         </div>
      </div>
    </Section>
  </main>
</Layout>