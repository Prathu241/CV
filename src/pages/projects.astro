---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { getContent } from '../lib/content';

const { projects } = await getContent();
---

<Layout title="Projects | Pratham Sarawad">
  <main class="pt-6 sm:pt-8 pb-14 min-h-screen">
    <Section id="all-projects" title="Projects" class="!pt-4 sm:!pt-6 !pb-12 sm:!pb-14">
      <div class="mb-8">
        <a href="/" class="magnetic inline-flex items-center text-slate-200 text-sm hover:text-primary transition-colors">
            ← Back to home
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
           {projects.map((project, index) => (
             <div class="project-card cyber-card group h-full flex flex-col animate-on-scroll stagger-item cursor-pointer" style={`--stagger:${index};`} data-project-id={index} data-project={JSON.stringify(project)}>
               <div class="h-48 bg-[#0a1422] relative overflow-hidden border-b border-white/5">
                <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.04),transparent)]"></div>
            </div>
            
            <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-xl font-semibold text-white mb-3 group-hover:text-primary transition-colors">{project.title}</h3>
                <p class="text-slate-300 text-sm leading-relaxed mb-6 flex-grow font-light border-l border-primary/30 pl-4">
                  {project.desc}
                </p>
                
                <div class="flex flex-wrap gap-2 pt-4 border-t border-white/5">
                    {project.tech.map(t => (
                        <span class="text-[10px] uppercase tracking-widest text-slate-200 bg-primary/12 border border-primary/20 px-2 py-1 rounded-full">
                          {t}
                        </span>
                    ))}
                </div>

                <div class="mt-4 flex flex-wrap gap-2">
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="magnetic cta-primary inline-flex items-center gap-2 rounded-md border border-primary/30 bg-primary/12 px-3 py-1.5 text-xs text-slate-100 hover:bg-primary/20 transition-colors">
                    Visit website
                  </a>
                  <a href={project.github} target="_blank" rel="noopener noreferrer" class="magnetic inline-flex items-center gap-2 rounded-md border border-white/15 bg-white/5 px-3 py-1.5 text-xs text-slate-100 hover:bg-white/10 hover:border-white/25 transition-colors">
                    View repository
                  </a>
                </div>
            </div>
          </div>
        ))}
      </div>
    </Section>
  </main>

  <!-- Project Modal -->
  <div id="project-modal" class="project-modal fixed inset-0 z-[200] pointer-events-none">
    <div class="project-modal__backdrop"></div>
    <div class="project-modal__content">
      <button class="project-modal__close" aria-label="Close project">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      
      <div class="project-modal__inner">
        <div class="project-modal__header">
          <h2 id="modal-title" class="text-4xl md:text-5xl font-bold text-white"></h2>
          <p id="modal-desc" class="text-lg text-slate-300 mt-4"></p>
        </div>
        
        <div class="project-modal__tech mt-8">
          <div id="modal-tech" class="flex flex-wrap gap-3"></div>
        </div>
        
        <div class="project-modal__cta mt-10 flex gap-4">
          <a id="modal-link" target="_blank" rel="noopener noreferrer" class="cta-primary px-6 py-3 bg-primary text-black font-semibold rounded-lg hover:bg-secondary transition-all">
            Visit Project
          </a>
          <a id="modal-github" target="_blank" rel="noopener noreferrer" class="px-6 py-3 border border-white/20 text-white rounded-lg hover:border-primary/50 hover:text-primary transition-all">
            Source Code
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const setupProjectModal = () => {
      const modal = document.getElementById('project-modal');
      const backdrop = document.querySelector('.project-modal__backdrop');
      const closeBtn = document.querySelector('.project-modal__close');
      const projectCards = document.querySelectorAll('.project-card');
      
      const openModal = (card) => {
        const projectData = JSON.parse(card.dataset.project);
        
        document.getElementById('modal-title').textContent = projectData.title;
        document.getElementById('modal-desc').textContent = projectData.desc;
        document.getElementById('modal-link').href = projectData.link;
        document.getElementById('modal-github').href = projectData.github;
        
        const techContainer = document.getElementById('modal-tech');
        techContainer.innerHTML = projectData.tech.map(t => 
          `<span class="px-3 py-1 bg-primary/20 border border-primary/40 rounded-full text-sm text-slate-100">${t}</span>`
        ).join('');
        
        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      };
      
      const closeModal = () => {
        modal.classList.remove('is-open');
        document.body.style.overflow = '';
      };
      
      projectCards.forEach(card => {
        card.addEventListener('click', (e) => {
          if (e.target.closest('a')) return;
          openModal(card);
        });
      });
      
      closeBtn.addEventListener('click', closeModal);
      backdrop.addEventListener('click', closeModal);
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) {
          closeModal();
        }
      });
    };
    
    document.addEventListener('DOMContentLoaded', setupProjectModal);
  </script>
</Layout>