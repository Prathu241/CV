---
import { isAuthenticated } from '../../lib/auth';

if (!isAuthenticated(Astro.cookies)) {
  return new Response(null, {
    status: 302,
    headers: {
      Location: '/admin/login',
      'Cache-Control': 'no-store',
      'X-Robots-Tag': 'noindex, nofollow'
    }
  });
}

return new Response(null, {
  status: 302,
  headers: {
    Location: '/',
    'Cache-Control': 'no-store',
    'X-Robots-Tag': 'noindex, nofollow'
  }
});
---
