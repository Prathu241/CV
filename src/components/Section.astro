---
interface Props {
  id: string;
  class?: string;
  title?: string;
}

const { id, class: className, title } = Astro.props;
---

<section id={id} class:list={["section-padding relative", className]}>
  {title && (
    <div class="mb-10 animate-on-scroll flex items-end gap-4">
      <div class="w-1 h-10 rounded-full bg-gradient-to-b from-primary to-secondary"></div>
      <div>
        <h2 class="text-3xl md:text-4xl font-semibold text-white tracking-tight">
          {title}
        </h2>
      </div>
      <div class="h-px flex-grow bg-gradient-to-r from-primary/35 to-transparent hidden md:block mb-2"></div>
    </div>
  )}
  <div class="animate-on-scroll">
    <slot />
  </div>
</section>
