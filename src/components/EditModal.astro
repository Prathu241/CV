---
const { initialData } = Astro.props;
---

<div id="visual-editor-modal" class="fixed inset-0 z-[100] hidden text-slate-100">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm" id="modal-backdrop"></div>
    
    <!-- Modal Content -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl bg-slate-950 border border-white/10 shadow-2xl animate-in fade-in zoom-in duration-200">
        <div class="flex justify-between items-center p-4 border-b border-white/5 bg-white/5">
            <h3 class="text-slate-100 font-mono uppercase tracking-widest text-sm" id="modal-title">Edit Content</h3>
            <button id="modal-close" class="text-slate-400 hover:text-slate-100">&times;</button>
        </div>
        
        <div class="p-6 max-h-[70vh] overflow-y-auto custom-scrollbar" id="modal-form-container">
            <!-- Dynamic Form Fields will be injected here -->
        </div>
        
        <div class="p-4 border-t border-white/5 bg-white/5 flex justify-end gap-3">
             <button id="modal-cancel" class="px-4 py-2 border border-white/10 text-xs font-mono text-slate-300 hover:text-slate-100 hover:border-white/30 transition-colors uppercase">Cancel</button>
             <button id="modal-save" class="px-6 py-2 bg-primary text-slate-950 font-bold text-xs font-mono uppercase hover:bg-white transition-colors">Save Changes</button>
        </div>
    </div>
</div>

<style>
    #visual-editor-modal input,
    #visual-editor-modal textarea {
        color: #e2e8f0;
        background-color: rgba(8, 12, 20, 0.96);
    }

    #visual-editor-modal input::placeholder,
    #visual-editor-modal textarea::placeholder {
        color: rgba(148, 163, 184, 0.75);
    }

    #visual-editor-modal input:focus,
    #visual-editor-modal textarea:focus {
        color: #f8fafc;
    }
</style>

<script define:vars={{ initialData }}>
    // Store content in local component scope to prevent global tampering
    let currentSiteContent = initialData;
    
    const modal = document.getElementById('visual-editor-modal');
    const formContainer = document.getElementById('modal-form-container');
    const modalTitle = document.getElementById('modal-title');
    let currentSection = null;
    let currentOriginalData = null;

    // Helper functions for safe DOM node creation (prevents DOM XSS)
    function createFormGroup(labelText, inputElement) {
        const div = document.createElement('div');
        const label = document.createElement('label');
        label.className = 'block text-xs text-gray-500 font-mono mb-1';
        label.textContent = labelText;
        div.appendChild(label);
        div.appendChild(inputElement);
        return div;
    }

    function createInput(value, dataField, isTextarea = false, rows = 2) {
        const el = isTextarea ? document.createElement('textarea') : document.createElement('input');
        if (!isTextarea) {
            el.type = 'text';
        } else {
            el.rows = rows;
        }
        el.className = 'w-full bg-black/50 border border-white/10 p-2 text-white text-sm font-mono focus:border-primary focus:outline-none';
        el.value = value || '';
        if (dataField) el.dataset.field = dataField;
        return el;
    }

    // Project Card Builder
    function createProjectCard(project, idx) {
        const card = document.createElement('div');
        card.className = 'project-entry p-4 border border-white/10 bg-black/30 rounded-lg space-y-3';

        const header = document.createElement('div');
        header.className = 'flex justify-between items-center mb-2';

        const title = document.createElement('h4');
        title.className = 'text-sm font-mono text-primary';
        title.textContent = `Project ${idx + 1}`;

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'text-red-400 hover:text-red-300 text-xs px-2 py-1 border border-red-400/30 rounded';
        removeBtn.textContent = 'Remove';
        removeBtn.dataset.remove = 'project';

        header.appendChild(title);
        header.appendChild(removeBtn);
        card.appendChild(header);

        card.appendChild(createFormGroup('Title', createInput(project.title, 'title')));
        card.appendChild(createFormGroup('Description', createInput(project.desc, 'desc', true, 2)));
        card.appendChild(createFormGroup('Tech (comma-separated)', createInput(Array.isArray(project.tech) ? project.tech.join(', ') : '', 'tech')));
        card.appendChild(createFormGroup('GitHub Link', createInput(project.github, 'github')));
        card.appendChild(createFormGroup('Website Link', createInput(project.link, 'link')));

        return card;
    }

    function createProjectsEditor(projects) {
        const container = document.createElement('div');
        container.className = 'space-y-6';

        (projects || []).forEach((project, idx) => {
            container.appendChild(createProjectCard(project, idx));
        });

        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'w-full px-4 py-2 mt-4 bg-primary/20 border border-primary text-primary text-xs font-mono hover:bg-primary/30 transition-colors rounded';
        addBtn.textContent = '+ Add New Project';
        addBtn.onclick = () => {
            const currentCount = container.querySelectorAll('.project-entry').length;
            const newCard = createProjectCard({
                title: 'New Project',
                desc: 'Project description',
                tech: ['Tech'],
                github: 'https://github.com/',
                link: 'https://github.com/'
            }, currentCount);
            addBtn.insertAdjacentElement('beforebegin', newCard);
        };
        container.appendChild(addBtn);

        formContainer.appendChild(container);
    }

    // Skill Card Builder
    function createSkillCard(skill, idx) {
        const card = document.createElement('div');
        card.className = 'skill-entry p-3 border border-white/10 bg-black/30 rounded-lg flex gap-3 items-end';

        const div = document.createElement('div');
        div.className = 'flex-1';
        const label = document.createElement('label');
        label.className = 'block text-xs text-gray-500 font-mono mb-1';
        label.textContent = 'Skill Name';

        const input = createInput(skill.name, 'name');
        div.appendChild(label);
        div.appendChild(input);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'text-red-400 hover:text-red-300 text-xs px-2 py-1 border border-red-400/30 rounded';
        removeBtn.textContent = 'Remove';
        removeBtn.dataset.remove = 'skill';

        card.appendChild(div);
        card.appendChild(removeBtn);
        return card;
    }

    function createSkillsEditor(skills) {
        const container = document.createElement('div');
        container.className = 'space-y-4';

        (skills || []).forEach((skill, idx) => {
            container.appendChild(createSkillCard(skill, idx));
        });

        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'w-full px-4 py-2 mt-4 bg-primary/20 border border-primary text-primary text-xs font-mono hover:bg-primary/30 transition-colors rounded';
        addBtn.textContent = '+ Add New Skill';
        addBtn.onclick = () => {
            const currentCount = container.querySelectorAll('.skill-entry').length;
            const newCard = createSkillCard({ name: 'New Skill' }, currentCount);
            addBtn.insertAdjacentElement('beforebegin', newCard);
        };
        container.appendChild(addBtn);
        formContainer.appendChild(container);
    }

    // Experience Card Builder
    function createExperienceCard(exp, idx) {
        const card = document.createElement('div');
        card.className = 'experience-entry p-4 border border-white/10 bg-black/30 rounded-lg space-y-3';

        const header = document.createElement('div');
        header.className = 'flex justify-between items-center mb-2';

        const title = document.createElement('h4');
        title.className = 'text-sm font-mono text-primary';
        title.textContent = `Experience ${idx + 1}`;

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'text-red-400 hover:text-red-300 text-xs px-2 py-1 border border-red-400/30 rounded';
        removeBtn.textContent = 'Remove';
        removeBtn.dataset.remove = 'experience';

        header.appendChild(title);
        header.appendChild(removeBtn);
        card.appendChild(header);

        card.appendChild(createFormGroup('Role', createInput(exp.role, 'role')));
        card.appendChild(createFormGroup('Company', createInput(exp.company, 'company')));
        card.appendChild(createFormGroup('Date', createInput(exp.date, 'date')));
        card.appendChild(createFormGroup('Description', createInput(exp.desc, 'desc', true, 2)));

        const detailsText = Array.isArray(exp.details) ? exp.details.join('\n') : '';
        card.appendChild(createFormGroup('Bullet Points (one per line)', createInput(detailsText, 'details', true, 3)));

        return card;
    }

    function createExperienceEditor(experiences) {
        const container = document.createElement('div');
        container.className = 'space-y-6';

        (experiences || []).forEach((exp, idx) => {
            container.appendChild(createExperienceCard(exp, idx));
        });

        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'w-full px-4 py-2 mt-4 bg-primary/20 border border-primary text-primary text-xs font-mono hover:bg-primary/30 transition-colors rounded';
        addBtn.textContent = '+ Add New Experience';
        addBtn.onclick = () => {
            const currentCount = container.querySelectorAll('.experience-entry').length;
            const newCard = createExperienceCard({
                role: 'New Role',
                company: 'Company Name',
                date: 'Date',
                desc: 'Description',
                details: []
            }, currentCount);
            addBtn.insertAdjacentElement('beforebegin', newCard);
        };
        container.appendChild(addBtn);
        formContainer.appendChild(container);
    }

    // Generic Fields Builder (for Profile, etc.)
    function generateFields(data, context) {
        if (!data || typeof data !== 'object') return;
        Object.keys(data).forEach(key => {
            const val = data[key];
            if (typeof val === 'string' || typeof val === 'number') {
                createInputField(key, String(val), context);
            }
        });
    }

    function createInputField(label, value, section) {
        const wrapper = document.createElement('div');
        wrapper.className = 'mb-4';
        
        const labelEl = document.createElement('label');
        labelEl.className = 'block text-xs font-mono text-gray-500 uppercase mb-1';
        labelEl.textContent = label;
        
        let input;
        if (value && value.length > 60) {
            input = document.createElement('textarea');
            input.rows = 4;
            input.className = "w-full bg-black/50 border border-white/10 p-2 text-white text-sm font-mono focus:border-primary focus:outline-none";
        } else {
            input = document.createElement('input');
            input.type = 'text';
            input.className = "w-full bg-black/50 border border-white/10 p-2 text-white text-sm font-mono focus:border-primary focus:outline-none";
        }
        input.value = value || '';
        input.dataset.key = label;
        input.dataset.section = section;
        
        wrapper.appendChild(labelEl);
        wrapper.appendChild(input);
        formContainer.appendChild(wrapper);
    }

    // Delegated Remove Handler attached ONCE
    formContainer.addEventListener('click', (e) => {
        const target = e.target;
        if (target && target.matches && target.matches('button[data-remove]')) {
            e.preventDefault();
            target.closest('.project-entry, .skill-entry, .experience-entry, .p-4, .p-3')?.remove();
        }
    });

    // Open Modal Function (Global Interface for buttons)
    window.openVisualEditor = (sectionKey) => {
        currentSection = sectionKey;
        const data = currentSiteContent ? currentSiteContent[sectionKey] : null;
        currentOriginalData = data ? JSON.parse(JSON.stringify(data)) : null;
        
        modalTitle.textContent = `EDITING: ${sectionKey.toUpperCase()}`;
        formContainer.innerHTML = ''; // Clear previous fields safely
        
        if (sectionKey === 'projects') {
            createProjectsEditor(data);
        } else if (sectionKey === 'skills') {
            createSkillsEditor(data);
        } else if (sectionKey === 'experience') {
            createExperienceEditor(data);
        } else {
            generateFields(data, sectionKey);
        }
        
        modal.classList.remove('hidden');
    };

    // Modal Close Handlers
    document.getElementById('modal-close').onclick = () => modal.classList.add('hidden');
    document.getElementById('modal-cancel').onclick = () => modal.classList.add('hidden');
    document.getElementById('modal-backdrop').onclick = (e) => {
        if (e.target.id === 'modal-backdrop') modal.classList.add('hidden');
    };

    // Save Changes Handler
    document.getElementById('modal-save').onclick = async () => {
        const btn = document.getElementById('modal-save');
        btn.textContent = 'Saving...';
        btn.setAttribute('disabled', 'true');
        
        try {
            const updatedData = JSON.parse(JSON.stringify(currentSiteContent));

            if (currentSection === 'projects') {
                const projectCards = formContainer.querySelectorAll('.project-entry');
                const projects = [];
                projectCards.forEach((card) => {
                    const title = card.querySelector('[data-field="title"]')?.value.trim() || '';
                    const desc = card.querySelector('[data-field="desc"]')?.value.trim() || '';
                    const techRaw = card.querySelector('[data-field="tech"]')?.value || '';
                    const tech = techRaw.split(',').map(t => t.trim()).filter(Boolean);
                    const github = card.querySelector('[data-field="github"]')?.value.trim() || '';
                    const link = card.querySelector('[data-field="link"]')?.value.trim() || '';

                    if (title) {
                        projects.push({ title, desc, tech, github, link });
                    }
                });
                updatedData.projects = projects;
            } else if (currentSection === 'skills') {
                const skillCards = formContainer.querySelectorAll('.skill-entry');
                const skills = [];
                skillCards.forEach((card, idx) => {
                    const name = card.querySelector('[data-field="name"]')?.value.trim() || '';
                    if (name) {
                        const originalIcon = currentOriginalData && currentOriginalData[idx]?.name === name 
                            ? currentOriginalData[idx].icon 
                            : 'https://skillicons.dev/icons?i=default';
                        skills.push({ name, icon: originalIcon });
                    }
                });
                updatedData.skills = skills;
            } else if (currentSection === 'experience') {
                const expCards = formContainer.querySelectorAll('.experience-entry');
                const experiences = [];
                expCards.forEach((card) => {
                    const role = card.querySelector('[data-field="role"]')?.value.trim() || '';
                    const company = card.querySelector('[data-field="company"]')?.value.trim() || '';
                    const date = card.querySelector('[data-field="date"]')?.value.trim() || '';
                    const desc = card.querySelector('[data-field="desc"]')?.value.trim() || '';
                    const detailsRaw = card.querySelector('[data-field="details"]')?.value || '';
                    const details = detailsRaw.split('\n').map(d => d.trim()).filter(Boolean);

                    if (role) {
                        experiences.push({ role, company, date, desc, details });
                    }
                });
                updatedData.experience = experiences;
            } else {
                const inputs = formContainer.querySelectorAll('input, textarea');
                const sectionUpdate = { ...(currentSiteContent[currentSection] || {}) };
                inputs.forEach(input => {
                    const key = input.dataset.key;
                    if (key) {
                        sectionUpdate[key] = input.value;
                    }
                });
                updatedData[currentSection] = sectionUpdate;
            }

            const response = await fetch('/api/content/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(updatedData)
            });

            if (response.ok) {
                currentSiteContent = updatedData;
                window.location.reload();
            } else {
                let message = 'Failed to save changes.';
                try {
                    const body = await response.json();
                    if (body?.error) {
                        message = body.error;
                        if (typeof message === 'string' && message.trim().startsWith('{')) {
                            try {
                                const parsed = JSON.parse(message);
                                if (parsed.message) {
                                    message = `GitHub Error: ${parsed.message}${parsed.documentation_url ? ' (' + parsed.documentation_url + ')' : ''}`;
                                }
                            } catch {}
                        }
                    }
                } catch {
                    const fallbackText = await response.text();
                    if (fallbackText) {
                        message = fallbackText;
                    }
                }
                alert(message);
            }
        } catch (err) {
            console.error(err);
            alert('Error: ' + (err instanceof Error ? err.message : String(err)));
        } finally {
            btn.textContent = 'Save Changes';
            btn.removeAttribute('disabled');
        }
    };
</script>