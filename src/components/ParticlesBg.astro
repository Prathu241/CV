<div id="tsparticles" class="fixed inset-0 -z-10 pointer-events-none"></div>

<script>
  import { tsParticles } from "@tsparticles/engine";
  import { loadSlim } from "@tsparticles/slim";

  // Initialize tsparticles
  (async () => {
    await loadSlim(tsParticles);

    await tsParticles.load({
      id: "tsparticles",
      options: {
        background: {
          color: {
              value: "transparent",
          },
        },
          fpsLimit: 60,
        interactivity: {
          events: {
            onClick: {
                enable: false,
              mode: "push",
            },
            onHover: {
              enable: true,
              mode: "grab", 
            },
          },
          modes: {
            grab: {
                distance: 110,
                links: {
                    opacity: 0.12
                }
            },
            push: {
              quantity: 4,
            },
          },
        },
        particles: {
          color: {
              value: ["#3b82f6", "#94a3b8"],
          },
          links: {
              color: "#3b82f6",
              distance: 140,
              enable: true,
              opacity: 0.08, 
            width: 1,
          },
          move: {
            direction: "none",
            enable: true,
            outModes: {
              default: "bounce",
            },
            random: true,
            speed: 0.3,
            straight: false,
          },
          number: {
            density: {
              enable: true,
            },
            value: 42,
          },
          opacity: {
            value: { min: 0.04, max: 0.16 },
          },
          shape: {
            type: "circle",
          },
          size: {
            value: { min: 1, max: 1.6 },
          },
        },
        detectRetina: true,
      },
    });
  })();
</script>
